# Netlify response headers.
#
# The app has no build step, so filenames are not content-hashed and a
# long browser cache would pin people to an old version the same way
# the old cache-first service worker did. Everything revalidates on
# each request; with ETags that is a cheap 304, not a re-download.
# Offline support comes from the service worker, not from here.
/*
  Cache-Control: public, max-age=0, must-revalidate

# The service worker script must always be revalidated, or a new one
# can never take over. no-cache (revalidate before use) rather than
# no-store (never keep a copy): no-cache is what the service worker
# spec and every browser vendor recommend here, and no-store is known
# to interact badly with some CDNs and HTTP caches.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# The manifest decides whether the app can be installed at all, so it
# must never be served from a stale copy either.
/manifest.json
  Cache-Control: no-cache

# Icons do have stable content, so they can be held for a week.
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/icon-180.png
  Cache-Control: public, max-age=604800
